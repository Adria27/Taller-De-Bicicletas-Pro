@{
    ViewData["Title"] = "Mecánicos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    .modal-header {
        background-color: #0d6efd;
        color: white;
    }

    .table-hover tbody tr:hover {
        background-color: #f1f1f1;
    }
</style>

<div class="container mt-5">

    <h2 class="text-center fw-bold mb-4">Gestión de Mecánicos</h2>

    <div class="d-flex justify-content-between mb-3">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalAgregar">
            ➕ Agregar Mecánico
        </button>

        <button class="btn btn-success" onclick="cargarMecanicos()">
            🔄 Actualizar
        </button>
    </div>

    <table class="table table-bordered table-hover text-center" id="tablaMecanicos">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Especialidad</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>

</div>

<!-- Modal AGREGAR -->
<div class="modal fade" id="modalAgregar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Agregar Mecánico</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input id="addNombre" class="form-control mb-2" placeholder="Nombre">
                <input id="addEspecialidad" class="form-control mb-2" placeholder="Especialidad">

            </div>

            <div class="modal-footer">
                <button class="btn btn-primary" onclick="crearMecanico()">Guardar</button>
            </div>

        </div>
    </div>
</div>

<!-- Modal EDITAR -->
<div class="modal fade" id="modalEditar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Editar Mecánico</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input id="editId" type="hidden">
                <input id="editNombre" class="form-control mb-2" placeholder="Nombre">
                <input id="editEspecialidad" class="form-control mb-2" placeholder="Especialidad">

            </div>

            <div class="modal-footer">
                <button class="btn btn-warning" onclick="actualizarMecanico()">Actualizar</button>
            </div>

        </div>
    </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>

    const API = "https://localhost:7159/api/Mecanicos";

    async function cargarMecanicos() {
        const res = await fetch(API);
        const data = await res.json();

        const tbody = document.querySelector("#tablaMecanicos tbody");
        tbody.innerHTML = "";

        data.forEach(m => {
            tbody.innerHTML += `
                <tr>
                    <td>${m.id}</td>
                    <td>${m.nombre}</td>
                    <td>${m.especialidad}</td>

                    <td>
                        <button class="btn btn-warning btn-sm" onclick="mostrarEditar(${m.id})">Editar</button>
                        <button class="btn btn-danger btn-sm" onclick="eliminarMecanico(${m.id})">Eliminar</button>
                    </td>
                </tr>
            `;
        });
    }

    cargarMecanicos();


    // CREAR MECÁNICO
    async function crearMecanico() {
        const dto = {
            nombre: document.getElementById("addNombre").value,
            especialidad: document.getElementById("addEspecialidad").value
        };

        await fetch(API, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(dto)
        });

        cargarMecanicos();
        alert("Mecánico agregado correctamente");
    }


    // MOSTRAR EN MODAL EDITAR
    async function mostrarEditar(id) {
        const res = await fetch(`${API}/${id}`);
        const m = await res.json();

        document.getElementById("editId").value = m.id;
        document.getElementById("editNombre").value = m.nombre;
        document.getElementById("editEspecialidad").value = m.especialidad;

        new bootstrap.Modal(document.getElementById("modalEditar")).show();
    }

    // ACTUALIZAR MECÁNICO
    async function actualizarMecanico() {
        const id = document.getElementById("editId").value;

        const dto = {
            id: id,
            nombre: document.getElementById("editNombre").value,
            especialidad: document.getElementById("editEspecialidad").value
        };

        await fetch(`${API}/${id}`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(dto)
        });

        cargarMecanicos();
        alert("Mecánico actualizado correctamente");
    }


    // ELIMINAR MECÁNICO
    async function eliminarMecanico(id) {
        if (!confirm("¿Eliminar este mecánico?")) return;

        await fetch(`${API}/${id}`, { method: "DELETE" });

        cargarMecanicos();
        alert("Mecánico eliminado correctamente");
    }

</script>
