<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <
    <title>Taller de Bicicletas — @ViewData["Title"]</title>


    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <style>
        body {
            background-color: #e9ecef;
        }

        .navbar {
            margin-bottom: 20px;
        }

        /* Modo oscuro */
        .dark-mode {
            background-color: #1a1a1a !important;
            color: white !important;
        }

            .dark-mode .navbar {
                background-color: white !important;
            }
    </style>

    <style>
        /* ======= COLOR PRINCIPAL MORADO ======= */
        :root {
            --principal: blueviolet;
        }
        
               /* ----------------------------
           BARRA SUPERIOR (Inicio/Atrás/Oscuro)
        -----------------------------*/
        .top-links {
            width: 100%;
            padding: 12px 25px;
            background-color: blueviolet; /* AHORA MORADO */
            text-align: right;
            box-shadow: 0 2px 6px rgba(0,0,0,0.2);
        }

            .top-links a {
                color: #ffffff;
                font-weight: 700; /* MÁS GRUESA */
                font-size: 20px; /* MÁS GRANDE */
                margin-left: 25px;
                text-decoration: none;
                letter-spacing: 0.5px;
                transition: .3s;
            }

                .top-links a:hover {
                    color: #ffd6ff; /* Morado claro */
                    text-shadow: 0 0 8px rgba(255,255,255,0.9);
                }

        /* ----------------------------
           HEADER PRINCIPAL (Título)
        -----------------------------*/
        header {
            background-color: blueviolet !important; /* MORADO */
            padding: 45px 0;
            color: white;
            text-align: center;
            box-shadow: 0px 4px 10px rgba(0,0,0,0.25);
            margin-bottom: 40px;
        }


        /* BOTONES PRINCIPALES EN MORADO */
        .btn-primary {
            background-color: var(--principal) !important;
            border-color: var(--principal) !important;
        }

            .btn-primary:hover {
                background-color: #6a1bbf !important;
                border-color: #6a1bbf !important;
            }

        /* Borde/hover de las cards */
        .card-custom:hover {
            box-shadow: 0px 6px 16px rgba(138,43,226,0.4) !important;
        }

    </style>

</head>

<body>

    <!-- 🟦 NAVBAR PRINCIPAL -->
    <nav class="navbar navbar-expand-lg shadow-sm" style="background-color: blueviolet;">

        <div class="container-fluid">

            <!-- Título del sistema -->
            <a class="navbar-brand fw-bold" href="/Home/Index">
                Taller de Bicicletas
            </a>

            <div class="collapse navbar-collapse justify-content-end">
                <ul class="navbar-nav">

                    <!-- Inicio -->
                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Index">Inicio</a>
                    </li>

                    <!-- Atrás -->
                    <li class="nav-item">
                        <a class="nav-link" href="javascript:history.back()">Atrás</a>
                    </li>

                    <!-- Cambiar tema -->
                    <li class="nav-item">
                        <a class="nav-link" href="#" onclick="toggleTheme()">🌙 Oscuro</a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <!-- Aquí se cargan todas las vistas -->
    <div class="container">
        @RenderBody()
    </div>


    <!-- Script para el modo oscuro -->
    <script>
        function toggleTheme() {
            document.body.classList.toggle("dark-mode");
        }
    </script>

</body>
</html>
